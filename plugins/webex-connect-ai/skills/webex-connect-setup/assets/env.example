# Copy to .env in the project that uses the Webex Connect APIs.
# Keep .env local, untracked, and restricted to the current user.

# Tenant and environment
WEBEX_CONNECT_ENVIRONMENT=
WEBEX_CONNECT_TENANT_DOMAIN=
WEBEX_CONNECT_REGION=
WEBEX_CONNECT_ORGANIZATION_ID=

# API base URLs; resolve each family from the current official endpoint reference.
WEBEX_CONNECT_API_BASE=
WEBEX_CONNECT_MESSAGING_V1_URL=
WEBEX_CONNECT_MESSAGING_V2_URL=
WEBEX_CONNECT_VOICE_API_BASE=
WEBEX_CONNECT_CONTACT_POLICY_BASE=
WEBEX_CONNECT_PROFILE_API_BASE=
WEBEX_CONNECT_AUDIT_LOGS_BASE=
WEBEX_CONNECT_DIGITAL_ASSET_API_BASE=
WEBEX_CONNECT_MCP_SERVER_URL=

# Direct API credentials. Keep unused credential types blank.
WEBEX_CONNECT_SERVICE_KEY=
WEBEX_CONNECT_SERVICE_JWT=
WEBEX_CONNECT_PROFILE_KEY=
WEBEX_CONNECT_DIGITAL_ASSET_ACCESS_TOKEN=
WEBEX_CONNECT_AUDIT_LOGS_ACCESS_TOKEN=

# Optional Email asset provider configuration. Populate only the fields
# required by the selected provider and current Email Digital Asset schema.
WEBEX_CONNECT_EMAIL_ASSET_MAILBOX=
WEBEX_CONNECT_EMAIL_SMTP_SERVER=
WEBEX_CONNECT_EMAIL_SMTP_USERNAME=
WEBEX_CONNECT_EMAIL_SMTP_PORT=
WEBEX_CONNECT_EMAIL_OAUTH_CLIENT_ID=
WEBEX_CONNECT_EMAIL_OAUTH_CLIENT_SECRET=
WEBEX_CONNECT_EMAIL_OAUTH_AUTH_URL=
WEBEX_CONNECT_EMAIL_OAUTH_SCOPE=
WEBEX_CONNECT_EMAIL_OAUTH_ACCESS_TOKEN_URL=
WEBEX_CONNECT_EMAIL_OAUTH_REFRESH_TOKEN_URL=
WEBEX_CONNECT_EMAIL_OAUTH_CALLBACK_URL=

# MCP Messaging for AI Agents (SMS and Email). Setup registers the regional
# server automatically for Production. Add only the bearer token through the
# selected host's secure MCP authentication flow. A project .env is not
# automatically loaded by every host.
WEBEX_CONNECT_MCP_CLIENT_ID=
WEBEX_CONNECT_MCP_CLIENT_SECRET=
WEBEX_CONNECT_MCP_ACCESS_TOKEN=
# Client ID and secret are optional host-specific OAuth fields; bearer-token
# setup requires only WEBEX_CONNECT_MCP_ACCESS_TOKEN.

# Optional webhook verification and API callback configuration.
WEBEX_CONNECT_HUB_SECRET=
WEBEX_CONNECT_CALLBACK_URL_AUTH_ID=
